{
    "name": "sarkhanrasimoghlu/lsim",
    "description": "Lsim Single Sms",
    "keywords": [
        "lsim",
        "laravel",
        "sms gonder",
        "send sms",
        "laravel sms",
        "php",
        "sendsms.az"
    ],
    "homepage": "https://github.com/Rasimoghlu/laravel-lsim-single-sms-package",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sarkhanrasimoghlu\\Lsim\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Sarkhan Rasimoghlu",
            "email": "nasibovsarxan92@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage",
        "test-unit": "phpunit --testsuite=Unit",
        "test-filter": "phpunit --filter",
        "analyse": "phpstan analyse src --level=8",
        "check-style": "phpcs",
        "fix-style": "phpcbf"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sarkhanrasimoghlu\\Lsim\\SmsServiceProvider"
            ]
        }
    }
}
